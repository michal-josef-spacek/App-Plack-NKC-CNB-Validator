#!/usr/bin/env perl

use strict;
use warnings;

use App::Plack::NKC::CNB::Validator;

our $VERSION = 0.02;

# Run.
exit App::Plack::NKC::CNB::Validator->new->run;

# Print version.
sub VERSION_MESSAGE {
	print $VERSION."\n";
	exit 0;
}

__END__

=pod

=encoding utf8

=head1 NAME

plack-nkc-cnb-validator - Tool for ČNB validator plack app.

=head1 SYNOPSIS

 plack-nkc-cnb-validator [-c changes_file] [-d] [-h] [--version]

=head1 DESCRIPTION

Tool to run of ČNB validator Plack web application.

=head1 ARGUMENTS

=over 8

=item * C<-c changes_file>

Option to set Changes file.

=item * C<-d>

Debug mode.

=item * C<-h>

Print help.

=item * C<--version>

Print version of script.

=back

=head1 EXAMPLE

 plack-nkc-cnb-validator -h

 # Output:
 # Usage: /home/skim/perl5/bin/plack-nkc-cnb-validator [-c changes_file] [-d] [-h] [--version]
 #         -c changes_file Changes file to present.
 #         -d              Debug mode.
 #         -h              Print help.
 #         --version       Print version.

